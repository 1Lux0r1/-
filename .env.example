# Скопируйте в .env.local и заполните. Сам .env.local в git не попадает.

# Приложение (публичные значения, попадают в клиент)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Только для Edge Functions (секреты Supabase), в клиент не попадают никогда
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MENTOR_MODEL=claude-opus-5-5
